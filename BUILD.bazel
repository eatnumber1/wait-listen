load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The BPF object, compiled with the hermetic Clang for -target bpf. BPF
# bytecode is the same for every host architecture. Only the kernel UAPI
# headers (pinned, from Debian's linux-libc-dev) and libbpf's BPF helper
# headers are visible: -nostdinc keeps the host and the libc out. asm/ comes
# from the x86_64 headers; for -target bpf every architecture's asm/types.h
# gives the same fixed-width types.
genrule(
    name = "bpf_object",
    srcs = [
        "src/wait_listen.bpf.c",
        "@libbpf//:source_headers",
        "@debian_sysroot_amd64_musl//:kernel_headers",
    ],
    outs = ["wait_listen.bpf.o"],
    cmd = """
        set -e
        inc=$(@D)/bpfinc
        mkdir -p $$inc/bpf
        for f in $(execpaths @libbpf//:source_headers); do
          case $$f in
            */src/bpf_helpers.h|*/src/bpf_helper_defs.h) cp $$f $$inc/bpf/ ;;
          esac
        done
        uapi=""
        for f in $(execpaths @debian_sysroot_amd64_musl//:kernel_headers); do
          case $$f in
            */usr/include/linux/bpf.h) uapi=$$(dirname $$(dirname $$f)) ;;
          esac
        done
        test -n "$$uapi"
        # -g: libbpf needs the object's BTF (the .maps definitions). The
        # prefix map keeps the build directory (a per-build sandbox path)
        # out of the debug info, so the binary is reproducible.
        $(execpath @llvm_musl_llvm//:bin/clang) -target bpf -O2 -g -Wall -Werror \
          -ffile-prefix-map=$$PWD=. -ffile-prefix-map=$$(pwd -P)=. \
          -nostdinc -I$$inc -I$$uapi -I$$uapi/x86_64-linux-gnu \
          -c $(location src/wait_listen.bpf.c) -o $@
    """,
    tools = ["@llvm_musl_llvm//:bin/clang"],
)

# Makes the object an input of the compile that #embeds it.
cc_library(
    name = "bpf_object_embed",
    textual_hdrs = [":bpf_object"],
)

cc_library(
    name = "listening",
    srcs = ["src/listening.c"],
    hdrs = ["src/listening.h"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    strip_include_prefix = "src",
)

cc_binary(
    name = "wait-listen",
    srcs = [
        "src/main.c",
    ],
    visibility = ["//visibility:public"],
    copts = [
        "-std=gnu23",
        "-Wall",
        "-Werror",
        # #embed searches --embed-dir, not the include path.
        "--embed-dir=$(GENDIR)",
    ],
    deps = [
        ":bpf_object_embed",
        ":listening",
        "@libbpf",
    ],
)

cc_test(
    name = "listening_test",
    srcs = ["tests/listening_test.c"],
    # Static musl: no shared libraries, so link the dependencies in.
    linkstatic = True,
    copts = [
        "-Wall",
        "-Werror",
    ],
    deps = [":listening"],
)


# What we ship: wait-listen as a static musl binary per CPU (the musl
# toolchain is selected by these platforms; ordinary builds and tests use the
# host platform).
[
    platform_transition_filegroup(
        name = "wait-listen_" + arch,
        srcs = [":wait-listen"],
        target_platform = "//platforms:linux_" + arch,
        visibility = ["//visibility:public"],
    )
    for arch in ["x86_64", "armv7"]
]

# Reproducibility: no build directory inside the release binaries.
sh_test(
    name = "no_build_paths_test",
    srcs = ["tests/no_build_paths_test.sh"],
    args = [
        "$(rootpaths :wait-listen_x86_64)",
        "$(rootpaths :wait-listen_armv7)",
    ],
    data = [
        ":wait-listen_armv7",
        ":wait-listen_x86_64",
    ],
)
