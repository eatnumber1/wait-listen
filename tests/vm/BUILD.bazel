# Root tests of wait-listen in VMs (DESIGN.md "Tests"): the pinned Debian
# kernel and QEMU (third_party/debian/lock.json), an initramfs whose /init is
# guest_init and which carries wait-listen, both built for the VM's CPU.
load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# PID 1 of the test VMs: static, like wait-listen itself.
cc_binary(
    name = "guest_init",
    srcs = ["guest_init.c"],
    copts = [
        "-Wall",
        "-Werror",
    ],
    linkstatic = True,
)

# Runs during the build (exec platform).
cc_binary(
    name = "mkcpio",
    srcs = ["mkcpio.c"],
    copts = [
        "-Wall",
        "-Werror",
    ],
)

# Kernels: the oldest and newest Debian has (bookworm's 6.1, forky's 7.3),
# and trixie's 6.12 between them (Warawara's Raspberry Pi kernel is 6.12):
# working on the oldest and newest is taken to mean working on all between.
_KERNELS = ["6_1", "6_12", "7_3"]

_ARCHES = {
    "x86_64": dict(
        deb = "amd64",
        qemu = "@debian_sysroot_qemu_amd64//:usr/bin/qemu-system-x86_64",
        machine = ["-machine", "q35"],
        console = "console=ttyS0",
        # x86-64 kernels have the JIT on (Debian: always on).
        jit = {"": ""},
    ),
    "armv7": dict(
        deb = "armhf",
        qemu = "@debian_sysroot_qemu_amd64//:usr/bin/qemu-system-arm",
        # The Raspberry Pi 2's CPU.
        machine = ["-machine", "virt", "-cpu", "cortex-a7"],
        console = "console=ttyAMA0",
        # With the BPF JIT (Debian's armmp default is off), and without it,
        # as on Raspberry Pi kernels, which have none.
        jit = {"_jit": "wl.jit=1", "_nojit": "wl.jit=0"},
    ),
}

[
    platform_transition_filegroup(
        name = "guest_" + arch,
        srcs = [
            ":guest_init",
            "//:wait-listen",
        ],
        target_platform = "//platforms:linux_" + arch,
    )
    for arch in _ARCHES
]

[
    genrule(
        name = "initramfs_" + arch,
        srcs = [
            ":guest_" + arch,
            "@debian_sysroot_busybox_%s//:busybox" % _ARCHES[arch]["deb"],
        ],
        outs = ["initramfs_%s.cpio" % arch],
        cmd = """
            for f in $(execpaths :guest_{arch}); do
              case $$f in
                */guest_init) init=$$f ;;
                */wait-listen) wl=$$f ;;
              esac
            done
            $(execpath :mkcpio) $@ init=$$init wait-listen=$$wl \
              busybox=$(execpath @debian_sysroot_busybox_{deb}//:busybox)
        """.format(arch = arch, deb = _ARCHES[arch]["deb"]),
        tools = [":mkcpio"],
    )
    for arch in _ARCHES
]

[
    sh_test(
        name = "vm_test_%s_%s%s" % (arch, kernel, variant),
        size = "large",
        srcs = ["run_vm_test.sh"],
        args = [
            "$(rootpath @debian_sysroot_qemu_amd64//:dynamic_loader)",
            "$(rootpath %s)" % _ARCHES[arch]["qemu"],
            "$(rootpath @debian_sysroot_vm_kernel_%s_%s//:kernel)" % (_ARCHES[arch]["deb"], kernel),
            "$(rootpath :initramfs_%s)" % arch,
        ] + _ARCHES[arch]["machine"] + [
            "--",
            _ARCHES[arch]["console"],
            cmdline,
        ],
        data = [
            "@debian_sysroot_vm_kernel_%s_%s//:kernel" % (_ARCHES[arch]["deb"], kernel),
            _ARCHES[arch]["qemu"],
            ":initramfs_" + arch,
            "@debian_sysroot_qemu_amd64//:dynamic_loader",
            "@debian_sysroot_qemu_amd64//:sysroot",
        ],
    )
    for arch in _ARCHES
    for kernel in _KERNELS
    for variant, cmdline in _ARCHES[arch]["jit"].items()
]
